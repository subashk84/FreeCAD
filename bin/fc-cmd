#!/bin/bash
# Run FreeCAD in console mode (no GUI).
#   bin/fc-cmd script.py        run a script
#   bin/fc-cmd -t TestDraft     run a unit test module
#   bin/fc-cmd --version
# Uses a throwaway profile so results do not depend on anyone's preferences.
set -euo pipefail
FC_HOME="${FC_HOME:-$HOME/fc-weekly}"
export FREECAD_USER_HOME="${FREECAD_USER_HOME:-${TMPDIR:-/tmp}/fc-lab-profile}"
mkdir -p "$FREECAD_USER_HOME"
exec timeout "${FC_TIMEOUT:-600}" "$FC_HOME/usr/bin/freecadcmd" "$@" </dev/null
